{
  "name": "instadrop",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-oriented downloader for public Instagram media.",
  "scripts": {
    "dev": "next dev",
    "next:build": "next build",
    "build": "opennextjs-cloudflare build",
    "cf:build": "opennextjs-cloudflare build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
